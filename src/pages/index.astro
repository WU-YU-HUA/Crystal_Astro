---
import Layout from "../layouts/Layout.astro";
import "../css/horoscope.css"; 

const res = await fetch(
    "https://e-closet-backend-931017863616.us-east1.run.app/api/agent/daily_horoscope/",
);
const data = await res.json();
const horo_list = data?.result || [];

// 建立星座日期對照表 (如果想換成英文，可直接將值改為 Aries, Taurus 等)
const zodiacInfo: Record<string, string> = {
    "牡羊座": "3/21~4/19",
    "金牛座": "4/20~5/20",
    "雙子座": "5/21~6/21",
    "巨蟹座": "6/22~7/22",
    "獅子座": "7/23~8/22",
    "處女座": "8/23~9/22",
    "天秤座": "9/23~10/23",
    "天蠍座": "10/24~11/22",
    "射手座": "11/23~12/21",
    "摩羯座": "12/22~1/19",
    "水瓶座": "1/20~2/18",
    "雙魚座": "2/19~3/20"
};
---

<Layout title="今日星座運勢 | Crystal Astro">
    <div class="horoscope-container">
        
        <div class="mobile-dropdown-toggle" id="mobileToggle" style={`--theme-color: ${horo_list[0] ? horo_list[0].LuckColor.Hex : '#b388ff'}`}>
            <span id="mobileToggleText">{horo_list[0] ? horo_list[0].Zodiac : '選擇星座'}</span>
            <svg style="transition: transform 0.3s ease;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>

        <aside class="tabs-sidebar" id="tabsSidebar">
            {
                horo_list.map((item: any, index: number) => (
                    <button
                        class={`tab-button ${index === 0 ? 'active' : ''}`}
                        data-target={`zodiac-${index}`}
                        style={`--theme-color: ${item.LuckColor.Hex}`}
                    >
                        {item.Zodiac} 
                        <span class="tab-subtitle">({zodiacInfo[item.Zodiac]})</span>
                    </button>
                ))
            }
        </aside>

        <main class="tab-content-container">
            {
                horo_list.map((item: any, index: number) => (
                    <div
                        id={`pane-zodiac-${index}`}
                        class={`tab-pane ${index === 0 ? 'active' : ''}`}
                        style={`--theme-color: ${item.LuckColor.Hex}`}
                    >
                        <h2 class="horoscope-title">{item.Zodiac} 今日運勢</h2>
                        <div class="horoscope-subtitle">
                            今日幸運色：{item.LuckColor.Color}
                            <span class="color-dot" style={`background-color: ${item.LuckColor.Hex};`} />
                        </div>

                        <div class="horoscope-section">
                            <h3>整體運勢 (指數：{item.Overall.Score}/10)</h3>
                            <p>{item.Overall.Desc}</p>
                        </div>

                        <div class="horoscope-section">
                            <h3>各項運勢解析</h3>
                            <ul class="analysis-list">
                                <li>
                                    <strong>💖 愛情 (指數：{item.Love.Score}/10)</strong>
                                    <p>{item.Love.Desc}</p>
                                </li>
                                <li>
                                    <strong>💼 事業 (指數：{item.Career.Score}/10)</strong>
                                    <p>{item.Career.Desc}</p>
                                </li>
                                <li>
                                    <strong>💰 財富 (指數：{item.Wealth.Score}/10)</strong>
                                    <p>{item.Wealth.Desc}</p>
                                </li>
                                <li>
                                    <strong>💪 健康 (指數：{item.Health.Score}/10)</strong>
                                    <p>{item.Health.Desc}</p>
                                </li>
                            </ul>
                        </div>
                    </div>
                ))
            }
        </main>
    </div>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabPanes = document.querySelectorAll('.tab-pane');
        
        // 抓取手機版專用的 DOM 元素
        const mobileToggle = document.getElementById('mobileToggle');
        const tabsSidebar = document.getElementById('tabsSidebar');
        const mobileToggleText = document.getElementById('mobileToggleText');

        // ================= 手機版下拉選單互動邏輯 =================
        // 點擊開關展開/收合選單
        mobileToggle?.addEventListener('click', (e) => {
            e.stopPropagation(); // 阻止事件冒泡，避免觸發全域點擊關閉
            tabsSidebar?.classList.toggle('show');
            
            // 處理箭頭旋轉動畫
            const svg = mobileToggle.querySelector('svg');
            if (svg) {
                svg.style.transform = tabsSidebar?.classList.contains('show') ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        });

        // 點擊畫面其他空白處時，自動收合選單
        document.addEventListener('click', (e) => {
            if (tabsSidebar?.classList.contains('show')) {
                const target = e.target as Node;
                // 如果點擊的地方不在側邊欄內部，且不是開關按鈕，就收起選單
                if (!tabsSidebar.contains(target) && !mobileToggle?.contains(target)) {
                    tabsSidebar.classList.remove('show');
                    const svg = mobileToggle?.querySelector('svg');
                    if (svg) svg.style.transform = 'rotate(0deg)';
                }
            }
        });

        // ================= 原本的頁籤切換邏輯 + 擴充 =================
        function activateTab(targetId: string | null) {
            if (!targetId) return;
            
            tabButtons.forEach(btn => btn.classList.remove('active'));
            tabPanes.forEach(pane => pane.classList.remove('active'));

            const targetBtn = document.querySelector(`.tab-button[data-target="${targetId}"]`) as HTMLElement;
            const targetPane = document.getElementById(`pane-${targetId}`);

            if (targetBtn && targetPane) {
                targetBtn.classList.add('active');
                targetPane.classList.add('active');

                // 當切換項目時，更新手機版開關顯示的文字
                if (mobileToggleText) {
                    // childNodes[0] 可以精準抓到最外層的純文字（例如 "牡羊座 "），避開內層 <span> 的日期
                    mobileToggleText.textContent = targetBtn.childNodes[0].textContent?.trim() || '';
                }

                // ==========================================
                // 🔥 修正版：抓取真正計算後的 theme-color 並同步給上方選單
                // ==========================================
                if (mobileToggle) {
                    // 使用 getComputedStyle 來確實抓到按鈕目前的顏色
                    const newColor = getComputedStyle(targetBtn).getPropertyValue('--theme-color').trim();
                    if (newColor) {
                        mobileToggle.style.setProperty('--theme-color', newColor);
                    }
                }
            }

            // 切換完成後，如果手機版選單是開啟的，就自動收合它
            if (tabsSidebar?.classList.contains('show')) {
                tabsSidebar.classList.remove('show');
                const svg = mobileToggle?.querySelector('svg');
                if (svg) svg.style.transform = 'rotate(0deg)';
            }
        }

        // 綁定點擊切換事件
        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                const targetId = button.getAttribute('data-target');
                activateTab(targetId);
            });
        });
    });
</script>