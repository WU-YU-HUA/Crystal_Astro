        advice: "調整喉輪頻率，改善內在溝通模式，建議戴左手。",
    },
    {
        id: "obsidian",
        name: "黑曜石 (Obsidian)",
        color: "#71717a",
        alias: "暗夜守護與深層排毒",
        appearance: "天然火山琉璃，非晶質。",
        efficacy: [
            "**極致辟邪**：黑曜石具有強大的「吸納性」，能像黑洞一樣吸收病氣、濁氣與負能量。它是極佳的護身符，能防止靈異干擾與小人。",
            "**心理映照**：它被稱為「真理之石」，能無情地反映出配戴者內心的陰暗面、恐懼與創傷，迫使人面對並療癒。",
        ],
        advice: "屬於投射性，主要功能為防禦與排濁（左進右出），戴右手。例外：貔貅為招財神獸，為求「進財」戴左手。",
    },
    {
        id: "tigers-eye",
        name: "虎眼石 (Tiger's Eye)",
        color: "#d97706",
        alias: "勇氣與行動",
        appearance: "含有石棉纖維的石英集合體，具貓眼效應。",
        efficacy: [
            "虎眼石結合了太陽的能量與大地的穩定，能激發勇氣、自信與行動力。",
            "它能幫助優柔寡斷的人做出決策，並提供心理上的保護感，特別適合創業初期或面臨重大挑戰時配戴。",
        ],
        advice: "配戴右手能將意念與力量投射出去，展現權威與行動力。",
    },
];
---

<Layout title="水晶研究指南 | Crystal Astro">
    <div class="crystals-container">
        <!-- Sidebar Tabs -->
        <aside class="tabs-sidebar">
            {
                crystals.map((crystal, index) => (
                    <button
                        class={`tab-button ${index === 0 ? "active" : ""}`}
                        data-target={crystal.id}
                        style={`--theme-color: ${crystal.color}`}
                    >
                        {crystal.name}
                    </button>
                ))
            }
        </aside>

        <!-- Content Area -->
        <main class="tab-content-container">
            {
                crystals.map((crystal, index) => (
                    <div
                        id={crystal.id}
                        class={`tab-pane ${index === 0 ? "active" : ""}`}
                        style={`--theme-color: ${crystal.color}`}
                    >
                        <h2 class="crystal-title">{crystal.name}</h2>
                        <p class="crystal-alias">{crystal.alias}</p>

                        <div class="crystal-section">
                            <h3>外觀特徵</h3>
                            <p>{crystal.appearance}</p>
                        </div>

                        <div class="crystal-section">
                            <h3>功效分析</h3>
                            <ul>
                                {crystal.efficacy.map((point) => (
                                    <li
                                        set:html={point.replace(
                                            /\*\*(.*?)\*\*/g,
                                            "<strong>$1</strong>",
                                        )}
                                    />
                                ))}
                            </ul>
                        </div>

                        <div class="crystal-section">
                            <h3>配戴建議</h3>
                            <p>{crystal.advice}</p>
                        </div>
                    </div>
                ))
            }
        </main>
    </div>
</Layout>

<script>
    // Tab switching logic
    document.addEventListener("DOMContentLoaded", () => {
        const tabButtons = document.querySelectorAll(".tab-button");
        const tabPanes = document.querySelectorAll(".tab-pane");

        tabButtons.forEach((button) => {
            button.addEventListener("click", () => {
                // Remove active class from all buttons and panes
                tabButtons.forEach((btn) => btn.classList.remove("active"));
                tabPanes.forEach((pane) => pane.classList.remove("active"));

                // Add active class to clicked button
                button.classList.add("active");

                // Show target pane
                const targetId = button.getAttribute("data-target");
                if (targetId) {
                    const targetPane = document.getElementById(targetId);
                    if (targetPane) {
                        targetPane.classList.add("active");
                    }
                }
            });
        });
    });
</script>
